# Copy to .env for local development. Never commit .env.

# Postgres (local Docker for dev; swap for a Supabase connection string when
# that project is created — see docs/ARCHITECTURE.md decision log).
DATABASE_URL="postgresql://iqtest:iqtest@localhost:5433/iqtest?schema=public"

# Redis (local Docker for dev; used for rate limiting now, background jobs
# and leaderboard caching from Phase 7/10 onward).
REDIS_URL="redis://localhost:6380"

# App
APP_NAME="Cognitive Assessment Platform"
APP_BASE_URL="http://localhost:3000"

# Session / token hashing (HMAC secret for OTP + magic-link + session token
# hashes — generate a real random value for anything beyond local dev, e.g.
# `openssl rand -hex 32`).
AUTH_HASH_SECRET="dev-only-insecure-secret-change-me"

# Email (Gmail SMTP, free tier ~500/day — see docs/PRD.md assumption #3,
# revisit weekly). Leave unset in local dev to fall back to the console
# email provider, which logs emails instead of sending them.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@example.com"

# Payments (Stripe, test mode — see docs/PRD.md assumption #2). Leave
# unset in local dev: the create-intent endpoint returns a clear
# "payment_not_configured" error instead of silently faking a payment.
# Get test keys from https://dashboard.stripe.com/test/apikeys and the
# webhook signing secret from the CLI (`stripe listen --print-secret`) or
# a configured webhook endpoint.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Social login (added post-Phase-11 — see docs/PRD.md §7 and
# docs/ARCHITECTURE.md decision log for why this reverses the original
# "no social login" non-goal). Leave unset in local dev: /api/auth/oauth/
# [provider]/start redirects to /login?error=oauth_not_configured instead
# of crashing or faking a sign-in.
# Google: https://console.cloud.google.com/apis/credentials — create an
# OAuth client ID (type "Web application"), authorized redirect URI
# `${APP_BASE_URL}/api/auth/oauth/google/callback`.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# LinkedIn: https://www.linkedin.com/developers/apps — create an app with
# the "Sign In with LinkedIn using OpenID Connect" product added,
# authorized redirect URI `${APP_BASE_URL}/api/auth/oauth/linkedin/callback`.
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# Weekly email reminders (requirement.txt §2.4). Shared secret the
# scheduler (cron/Vercel Cron/etc. — final choice is a Phase 14 hosting
# decision) must send as `Authorization: Bearer <value>` when calling
# POST /api/cron/send-reminders. Generate a real random value for
# anything beyond local dev, e.g. `openssl rand -hex 32`.
CRON_SECRET="dev-only-insecure-cron-secret-change-me"
